# Salin file ini jadi ".env" lalu isi nilainya. JANGAN commit .env ke Git.

# --- Email (SMTP) ---
# Default di bawah untuk Gmail / Google Workspace.
# Kalau email pawsly.id ada di provider lain (Zoho, Titan, cPanel, dll),
# ganti SMTP_HOST & SMTP_PORT sesuai info dari penyedia email kamu.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=admin@pawsly.id
SMTP_PASS=isi-app-password-atau-password-smtp
# Alamat "from" yang tampil (opsional; default = SMTP_USER)
FROM_EMAIL=admin@pawsly.id
# Inbox yang menerima notifikasi tiap ada booking baru (boleh sama dengan SMTP_USER)
OWNER_EMAIL=admin@pawsly.id

# Nama bisnis (muncul sebagai nama pengirim email)
BUSINESS_NAME=Fu Fu Mahjong & Cafe

# Kunci rahasia untuk endpoint pemilik (lihat daftar booking / tandai lunas).
# Buat string acak yang panjang, jangan dibagikan.
ADMIN_KEY=ganti-dengan-string-acak-panjang

# Lokasi file database. Di hosting, arahkan ke disk permanen (lihat guide).
DB_PATH=./data/reservasi.db

# Berapa menit meja ditahan sebelum bayar (default 30).
HOLD_MINUTES=30

# Port server lokal
PORT=3001

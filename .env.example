# Salin file ini jadi ".env" lalu isi nilainya. JANGAN commit .env ke Git.
# Di Render, isi nilai-nilai ini di tab "Environment".

# --- Email (SMTP) — admin@pawsly.id di Google Workspace ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587   # coba 587 kalau 465 timeout
SMTP_USER=admin@pawsly.id
SMTP_PASS=isi-google-app-password
FROM_EMAIL=admin@pawsly.id

# --- Alternatif email lewat HTTPS (dipakai kalau SMTP diblokir hosting) ---
# Daftar gratis di resend.com, buat API key, tempel di sini.
# Kalau ini diisi, email dikirim via Resend (bukan SMTP).
RESEND_API_KEY=
OWNER_EMAIL=admin@pawsly.id

# Nama bisnis (muncul sebagai pengirim email)
BUSINESS_NAME=Fu Fu Mahjong & Cafe

# --- Rekening tujuan transfer (metode kode unik) ---
BANK_NAME=BCA
BANK_ACCOUNT=1234567890
BANK_HOLDER=Nama Pemilik Rekening

# --- Admin dashboard (/admin) ---
# Kunci rahasia untuk masuk ke /admin. Buat string acak yang panjang.
ADMIN_KEY=ganti-dengan-string-acak-panjang

# Lokasi database. Di hosting, arahkan ke disk permanen (lihat START-HERE).
DB_PATH=./data/reservasi.db

# --- WhatsApp otomatis (Fonnte) ---
# Daftar di fonnte.com, sambungkan nomor WA (scan QR), lalu tempel device token.
# Kalau diisi, pelanggan otomatis dapat WA saat booking & saat lunas.
FONNTE_TOKEN=

# Lama meja ditahan sebelum bayar (menit).
HOLD_MINUTES=15

PORT=3001
